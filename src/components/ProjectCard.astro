---
import type { Project } from '../content/site';

interface Props { project: Project }
const { project: p } = Astro.props;
const order = { back: 0, main: 1, front: 2 } as const;
const shots = [...p.shots].sort((a, b) => order[a.role] - order[b.role]);
---
<article class="project" aria-labelledby={`project-${p.id}`}>
  <div class="project__copy">
    <div class="project__head">
      <h3 id={`project-${p.id}`} class="project__name">
        <img src={p.logo.src} alt={p.logo.alt} width={p.logo.width} height={p.logo.height} loading="lazy" decoding="async" />
      </h3>
      <span class="project__badge">{p.badge}</span>
    </div>
    <p class="project__pitch">{p.pitch}</p>

    <dl class="project__stats">
      {p.stats.map((s) => (
        <div class="project__stat">
          <dt class={s === p.stats[0] ? 'opal-text' : undefined}>{s.value}</dt>
          <dd>{s.label}</dd>
        </div>
      ))}
    </dl>

    {p.tiers && (
      <div class="project__tiers">
        {p.tiers.map((t) => (
          <div class="project__tier"><h4>{t.name}</h4><p>{t.body}</p></div>
        ))}
      </div>
    )}

    <div class="project__links">
      {p.links.demo && <a class="btn btn--primary" href={p.links.demo.href} target="_blank" rel="noopener">{p.links.demo.label}</a>}
      {p.links.code && <a class="btn btn--secondary" href={p.links.code.href} target="_blank" rel="noopener">{p.links.code.label}</a>}
    </div>
  </div>

  <div class="project__shots">
    {shots.map((s) => (
      <figure class="project__shot" data-role={s.role} style={`--ratio: ${s.width} / ${s.height}`}>
        <span class="project__bar" aria-hidden="true"><i></i><i></i><i></i></span>
        <span class="project__frame">
          <img src={s.src} alt={s.alt} width={s.width} height={s.height} loading="lazy" decoding="async" />
        </span>
      </figure>
    ))}
  </div>
</article>

<style>
  .project { display: grid; gap: var(--space-7); align-items: center; }
  .project__head { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-3); }
  .project__name { margin: 0; line-height: 0; }
  .project__name img { height: var(--space-6); width: auto; }
  .project__badge {
    font-family: var(--font-mono); font-size: var(--fs-label); line-height: var(--lh-label);
    padding: var(--space-1) var(--space-3); border-radius: var(--radius-control);
    border: var(--border-w) solid var(--border); color: var(--muted);
  }
  .project__pitch { margin: var(--space-4) 0 0; color: var(--muted); max-width: var(--measure-text); }

  .project__stats { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--space-3); margin: var(--space-5) 0 0; }
  .project__stat { border: var(--border-w) solid var(--border); border-radius: var(--radius-control); padding: var(--space-3); }
  .project__stat dt { font-family: var(--font-heading); font-weight: var(--fw-heading); font-size: var(--fs-h2); line-height: var(--lh-h2); }
  .project__stat dd { margin: var(--space-1) 0 0; font-size: var(--fs-label); line-height: var(--lh-label); color: var(--muted); }

  .project__tiers { display: grid; gap: var(--space-3); margin-top: var(--space-4); }
  .project__tier { border-radius: var(--radius-control); padding: var(--space-3); background: var(--tier-bg); }
  .project__tier h4 { margin: 0 0 var(--space-1); font-family: var(--font-heading); font-weight: var(--fw-heading); font-size: var(--fs-body); }
  .project__tier p { margin: 0; font-size: var(--fs-label); line-height: var(--lh-label); color: var(--muted); }

  .project__links { display: flex; flex-wrap: wrap; gap: var(--space-3); margin-top: var(--space-6); }

  /* Screenshots: the frames keep their size from the data, so a missing image never moves the layout. */
  .project__shots { position: relative; }
  .project__shot { margin: 0; border-radius: var(--radius-card); overflow: hidden; background: var(--white);
    border: var(--border-w) solid var(--feature-border); box-shadow: var(--shot-shadow); }
  .project__bar { display: flex; gap: var(--space-1); align-items: center; height: var(--space-4); padding: 0 var(--space-2); background: var(--shot-bar); }
  .project__bar i { width: var(--space-2); height: var(--space-2); border-radius: var(--radius-round); background: var(--shot-dot); }
  .project__frame { display: block; position: relative; aspect-ratio: var(--ratio); }
  .project__frame img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; color: var(--ink); font-size: var(--fs-label); }
  .project__shot[data-role='back'], .project__shot[data-role='front'] { display: none; }

  @media (min-width: 48rem) {
    .project { grid-template-columns: 1fr 1.15fr; }
    .project__tiers { grid-template-columns: 1fr 1fr; }
    .project__shots { aspect-ratio: var(--shots-ratio); }
    .project__shot { position: absolute; display: block; }
    .project__shot[data-role='main'] { left: 0; top: 10%; width: 78%; z-index: 2; --tilt: var(--tilt-main); }
    .project__shot[data-role='back'] { display: block; right: 0; top: 0; width: 50%; z-index: 1; --tilt: var(--tilt-back); }
    .project__shot[data-role='front'] { display: block; right: 6%; bottom: 0; width: 34%; z-index: 3; --tilt: var(--tilt-front); }
    .project__shot { transform: rotate(var(--tilt)); animation: shot-float var(--float-dur) ease-in-out infinite; }
    .project__shot[data-role='back'] { animation-delay: calc(var(--float-dur) / -3); }
    .project__shot[data-role='front'] { animation-delay: calc(var(--float-dur) / -1.5); }
  }
  @keyframes shot-float { 50% { transform: translateY(calc(-1 * var(--float-y))) rotate(var(--tilt)); } }
  @media (prefers-reduced-motion: reduce) { .project__shot { animation: none !important; } }
</style>
