---
import { site } from '../content/site';
const oss = site.openSource;
---
<section id="open-source" class="section" aria-labelledby="open-source-title">
  <div class="container">
    <h2 id="open-source-title">{site.sections.openSource}</h2>
    <article class="oss" aria-labelledby="oss-title">
      <div class="oss__copy">
        <div class="oss__head">
          <h3 id="oss-title">{oss.title}</h3>
          <span class="oss__badge">{oss.status}</span>
        </div>
        <p>{oss.description}</p>
        {oss.href && <a class="btn btn--secondary" href={oss.href} rel="noopener">{oss.title}</a>}
      </div>
      <ul class="oss__terminal" role="list" data-terminal>
        {oss.features.map((f) => <li>{f}</li>)}
      </ul>
    </article>
  </div>
</section>

<script>
  import { onReveal, prefersReducedMotion } from '../motion/reveal';
  import { typeLines } from '../motion/terminal';
  const term = document.querySelector<HTMLElement>('[data-terminal]');
  if (term) {
    if (!prefersReducedMotion()) term.dataset.pending = 'true';
    onReveal(term, () => void typeLines(term), { threshold: 0.5 });
  }
</script>

<style>
  .oss {
    display: grid; gap: var(--space-6); margin-top: var(--space-7); padding: var(--space-6);
    border: var(--border-w) solid var(--border); border-radius: var(--radius-card); background: var(--surface);
  }
  .oss__head { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-3); }
  .oss__badge {
    font-family: var(--font-mono); font-size: var(--fs-label); line-height: var(--lh-label);
    padding: var(--space-1) var(--space-3); border-radius: var(--radius-control);
    border: var(--border-w) solid var(--border); color: var(--muted);
  }
  .oss__copy p { margin: var(--space-4) 0 0; color: var(--muted); max-width: 36rem; }
  .oss__copy .btn { margin-top: var(--space-5); }

  .oss__terminal {
    margin: 0; padding: var(--space-5); list-style: none; display: grid; gap: var(--space-2);
    border-radius: var(--radius-control); background: var(--ink-deep); color: var(--muted);
    font-family: var(--font-mono); font-size: var(--fs-label); line-height: var(--lh-label);
  }
  :global([data-theme='dark']) .oss__terminal { background: var(--bg); border: var(--border-w) solid var(--border); }
  .oss__terminal li { white-space: nowrap; overflow: hidden; }
  .oss__terminal li::before { content: '› '; color: var(--gold); }
  /* Waiting to type: hidden visually only, never removed. */
  .oss__terminal[data-pending='true'] li:not([data-typed='true']):not([data-typing='true']) { clip-path: inset(0 100% 0 0); }

  @media (min-width: 48rem) {
    .oss { grid-template-columns: 7fr 5fr; align-items: center; }
  }
</style>
