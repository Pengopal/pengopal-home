---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../content/site';
---
<Base title={site.notFound.title} description={site.meta.description}>
  <Header base="/" />
  <main id="main" class="container notfound">
    <h1>{site.notFound.heading}</h1>
    <p>{site.notFound.body}</p>
    <a href="/">{site.notFound.home}</a>
  </main>
  <Footer />
</Base>

<style>
  .notfound { padding-block: var(--space-9); min-height: var(--notfound-min-h); display: grid; align-content: center; gap: var(--space-4); }
  .notfound p { margin: 0; color: var(--muted); }
  .notfound a { color: var(--text); font-weight: var(--fw-strong); }
</style>
